\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{exercise-common}[2026/05/03 Compact exercise style]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[catalan,spanish,es-nodecimaldot]{babel}
\RequirePackage{lmodern}
\RequirePackage[a4paper,margin=1.55cm]{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{array}
\RequirePackage[hidelinks]{hyperref}

\definecolor{ExerciseBlue}{HTML}{1F4E79}
\definecolor{ExerciseGray}{HTML}{555555}
\definecolor{ExerciseLightGray}{HTML}{F2F4F7}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.35em}
\setlength{\tabcolsep}{0.45em}
\renewcommand{\arraystretch}{1.12}

\setlist[itemize]{topsep=0.2em,itemsep=0.15em,leftmargin=1.3em}
\setlist[enumerate]{topsep=0.2em,itemsep=0.2em,leftmargin=1.6em}

\newcommand{\exerciseTitle}[1]{%
  {\Large\bfseries\color{ExerciseBlue} #1}\par
  \vspace{0.25em}
}

\newcommand{\exerciseMeta}[6]{%
  {\small\color{ExerciseGray}
  Curso: #1 \quad
  Bloque: #2 \quad
  Tema: #3 \quad
  Tipo: #4 \quad
  Dificultad: #5/5 \quad
  Tiempo: #6 min}\par
  \vspace{0.45em}
  \hrule
  \vspace{0.65em}
}

\newcommand{\sectionLabel}[1]{%
  \vspace{0.3em}
  {\bfseries\color{ExerciseBlue} #1}\par
}

\newenvironment{exerciseParts}{%
  \begin{enumerate}[label=\alph*),leftmargin=1.4em]
}{%
  \end{enumerate}
}

\newcommand{\figurePlaceholder}[1]{%
  \begin{center}
    \fbox{%
      \begin{minipage}[c][3.3cm][c]{0.82\linewidth}
        \centering\small\color{ExerciseGray} #1
      \end{minipage}
    }
  \end{center}
}

\newcommand{\keyIdea}[1]{%
  \sectionLabel{Idea clave}
  #1\par
}

\newenvironment{solutionSteps}{%
  \sectionLabel{Resolucion paso a paso}
  \begin{enumerate}[label=\textbf{Paso \arabic*.},leftmargin=*,itemsep=0.35em]
}{%
  \end{enumerate}
}

\newcommand{\finalResult}[1]{%
  \vspace{0.35em}
  \noindent\colorbox{ExerciseLightGray}{%
    \parbox{\dimexpr\linewidth-2\fboxsep\relax}{\textbf{Resultado final:} #1}
  }\par
}
